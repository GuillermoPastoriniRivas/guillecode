{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "guillecode",
  "version": "0.2.0",
  "identifier": "com.guillecode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run build:pwa"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GuilleCode",
        "width": 1480,
        "height": 920,
        "minWidth": 980,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/opencode"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../dist-pwa/": "dist-pwa/"
    }
  }
}
